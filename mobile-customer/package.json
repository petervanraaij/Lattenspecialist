    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.4.3",
    "@capacitor/ios": "8.5.2",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
